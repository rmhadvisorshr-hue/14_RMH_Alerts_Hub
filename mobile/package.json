{
  "name": "rmh-alerts-mobile",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development --host",
    "build": "vite build --mode production && node scripts/check-prod.mjs dist",
    "test": "node --test",
    "sync": "cap sync android",
    "build:sync": "npm run build && cap sync android && node scripts/check-prod.mjs android",
    "live:emulator": "cap run android -l --host 10.0.2.2 --port 5173",
    "live:device": "cap run android -l --external --port 5173"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
