# Neon connection string (Neon dashboard -> Connect -> pooled connection). Keep it ONLY here / on the host.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# The one shared login used by staff (desktop) and Sir (mobile)
APP_USER_EMAIL=staff@rmhadvisors.example
APP_USER_PASSWORD=change-me-too
# Push notifications (Firebase). Whole service-account JSON on ONE line (Render: paste it as the value).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Shared secret for the GitHub Actions daily job: python -c "import secrets;print(secrets.token_urlsafe(32))"
CRON_SECRET=
